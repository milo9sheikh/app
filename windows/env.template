# Settings for running on Windows. Edit the values marked CHANGE, then save.
# Password of the PostgreSQL "postgres" user that you chose while installing PostgreSQL:
DATABASE_URL=postgresql://postgres:CHANGE_DB_PASSWORD@localhost:5432/attendance
PORT=3000
# Long random text; encrypts router passwords. Do not change it later.
ROUTER_ENCRYPTION_KEY=CHANGE_TO_A_LONG_RANDOM_TEXT
# First login (created only once, on first start):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
