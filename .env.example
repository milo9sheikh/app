# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-this-database-password
# Used by the API/worker when running outside docker-compose:
# DATABASE_URL=postgresql://attendance:password@localhost:5432/attendance

# Encrypts router credentials at rest (AES-256-GCM). Use a long random string; changing it makes stored router passwords unreadable.
ROUTER_ENCRYPTION_KEY=change-this-to-a-long-random-secret

# First SUPER_ADMIN, created only when the users table is empty. If ADMIN_PASSWORD is unset a random one is printed once in the API log.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

NODE_ENV=production
DEFAULT_TIMEZONE=Asia/Dhaka
